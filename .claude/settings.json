{
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:all)",
      "Bash(npm run check)",
      "Bash(npm run check:docs)",
      "Bash(npm run check:boundary:*)",
      "Bash(node --test:*)",
      "Bash(node scripts/check-docs.mjs:*)",
      "Bash(node scripts/check-public-boundary.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./docs/evidence/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
