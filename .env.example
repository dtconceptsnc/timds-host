# Installation record (nonsecret) plus runtime secrets for one TimDS host.
#
#   cp .env.example .env && chmod 600 .env
#
# scripts/deploy-host.py reads the checkout's .env and refuses a file that is
# group- or world-readable. Never commit or print the filled-in copy. Values
# below are synthetic; docs/operations.md explains each setting. Local checks
# (npm run check, npm run build) need none of this.

# --- Required: the deploy helper exits without these -------------------------
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
# Lowercase, [a-z0-9][a-z0-9-]{0,48}. Names the Worker and its owned resources.
TIMDS_WORKER_NAME=timds-example
# Exact HTTPS origin, no path.
TIMDS_HOST_ORIGIN=https://timds-example.example.workers.dev

# --- Required for a working installation -------------------------------------
# The companion public Worker, `${TIMDS_WORKER_NAME}-public`.
TIMDS_PUBLIC_ORIGIN=https://timds-example-public.example.workers.dev
# Organization namespace -> unique ARTIFACTS_... binding. Unlisted namespaces
# fail closed; add and deploy an entry before provisioning its sources.
TIMDS_ARTIFACTS_BINDINGS={"example":"ARTIFACTS_EXAMPLE"}
# Space-separated origins Studio may frame (live views and Previews). Empty
# means frame-src 'none'.
TIMDS_STUDIO_FRAME_ORIGINS=https://*.example.workers.dev
# Cloudflare Access. Leave both empty until the Access application exists
# (interactive sign-in fails closed), then set them and redeploy.
TIMDS_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
TIMDS_ACCESS_AUD=
# The designer agent's returned principal id; set after creating it, redeploy.
TIMDS_DESIGNER_PRINCIPAL_ID=
TIMDS_DESIGNER_MODEL=gpt-6-sol

# --- Optional -----------------------------------------------------------------
# Leave empty to use the queue id `deploy-host.py resources` records in
# .env.deploy-state.json.
TIMDS_AGENT_PUSH_QUEUE_ID=
# One additional exact HTTPS origin for Studio, attached as a custom domain.
TIMDS_STUDIO_ORIGIN=https://studio.example.com
TIMDS_PORTAL_ORIGIN=
TIMDS_ARTIFACTS_REST_FALLBACK=false
TIMDS_WORKERS_SUBDOMAIN_ALIASES={}
TIMDS_MEDIA_LEGACY_BINDINGS={}
TIMDS_MEDIA_ALLOWED_ORIGINS=[]
TIMDS_LEGACY_PUBLIC_HOSTS={}
# Apply migrations/0004_access_invitations.sql before enabling.
TIMDS_ACCESS_INVITATIONS_ENABLED=false
# One-time import of runtime secrets from a legacy server (import-secrets).
TIMDS_SECRETS_SSH_HOST=
TIMDS_SECRETS_SSH_FILE=

# --- Runtime secrets: `deploy-host.py deploy` requires all five ---------------
# Artifacts REST fallback credential.
CLOUDFLARE_API_TOKEN=
# Registered Workers Builds deployment token (Previews, live Workers, events).
TIMDS_BUILDS_API_TOKEN=
# Live designer execution.
OPENAI_API_KEY=
# Fresh random value for the first administrator; import-secrets generates one
# when this is empty.
TIMDS_BOOTSTRAP_SECRET=
# Shared with the portal for import transfers.
TIMDS_PORTAL_TRANSFER_SECRET=
