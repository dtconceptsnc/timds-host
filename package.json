{
  "name": "timds-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run check:docs && npm run check:boundary",
    "check:docs": "node scripts/check-docs.mjs",
    "check:boundary": "node scripts/check-public-boundary.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@dtconcepts/timds": "0.1.476",
    "@types/node": "22.20.5",
    "cf": "1.0.0-beta.14",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.0",
    "ignore": "7.0.5",
    "jose": "6.2.12",
    "zod": "4.3.6"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "@modelcontextprotocol/server": "$@modelcontextprotocol/server",
      "@modelcontextprotocol/client": "2.3.1"
    }
  }
}
