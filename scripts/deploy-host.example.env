# Copy to .env (chmod 600). Installation record (nonsecret) plus runtime secrets.
# Installation
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
TIMDS_WORKER_NAME=timds-example
TIMDS_HOST_ORIGIN=https://timds-example.example.workers.dev
TIMDS_STUDIO_ORIGIN=https://studio.example.com
TIMDS_PUBLIC_ORIGIN=https://timds-example-public.example.workers.dev
TIMDS_PORTAL_ORIGIN=
TIMDS_AGENT_PUSH_QUEUE_ID=
TIMDS_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
TIMDS_ACCESS_AUD=
TIMDS_DESIGNER_PRINCIPAL_ID=
TIMDS_DESIGNER_MODEL=gpt-6-sol
TIMDS_ARTIFACTS_BINDINGS={"example":"ARTIFACTS_EXAMPLE"}
TIMDS_ARTIFACTS_REST_FALLBACK=false
TIMDS_WORKERS_SUBDOMAIN_ALIASES={}
TIMDS_MEDIA_LEGACY_BINDINGS={}
TIMDS_MEDIA_ALLOWED_ORIGINS=[]
TIMDS_LEGACY_PUBLIC_HOSTS={}
TIMDS_STUDIO_FRAME_ORIGINS=https://*.example.workers.dev
TIMDS_ACCESS_INVITATIONS_ENABLED=false
# Optional one-time import of runtime secrets from a legacy server (import-secrets)
TIMDS_SECRETS_SSH_HOST=
TIMDS_SECRETS_SSH_FILE=
# Runtime secrets (never commit)
CLOUDFLARE_API_TOKEN=
TIMDS_BUILDS_API_TOKEN=
OPENAI_API_KEY=
TIMDS_BOOTSTRAP_SECRET=
TIMDS_PORTAL_TRANSFER_SECRET=
